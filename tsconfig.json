{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"declaration": true
	},
	"include": ["src/**/*.ts"]
}
